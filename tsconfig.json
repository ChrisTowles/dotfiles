{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["@types/bun"]
  },
  "include": ["bin/**/*.ts", "lib/**/*.ts", "modules/**/*.ts", "config/**/*.ts", "bootstrap.ts"]
}
