# ~/.zshrc → modules/zsh/zshrc (linked by `ttd setup`).
# Shell-wide setup is in base.zsh. Everything per tool is generated by
# `ttd gen zsh` from modules/*/ into ~/.cache/dotfiles/init.zsh.

DOTFILES_DIR="${DOTFILES_DIR:-$HOME/code/p/dotfiles}"
source "$DOTFILES_DIR/modules/zsh/base.zsh"

# Regenerate the init when a file that feeds the emitter is newer than it.
# Linked config files are not in the glob. A normal start runs no Bun.
_ttd_init="$HOME/.cache/dotfiles/init.zsh"
_ttd_new=( "$DOTFILES_DIR"/{modules,lib}/**/*.(ts|zsh)(.Nom[1]) )
if [[ ! -r $_ttd_init || $_ttd_new[1] -nt $_ttd_init ]] && (( $+commands[ttd] )); then
  command ttd gen zsh >/dev/null || print -u2 "ttd gen failed: using the old init"
fi
[[ -r $_ttd_init ]] && source "$_ttd_init"
unset _ttd_init _ttd_new
zsh_debug_section "init.zsh"

# Untracked per-machine overrides (CLAUDE_BACKUP_REPO, AWS_SSO_*, …)
[[ -r "$HOME/.zshrc_local.sh" ]] && source "$HOME/.zshrc_local.sh"
zsh_debug_section "local-zshrc"

if [[ -n "$ZSH_DEBUG_TIMING" ]]; then
  printf '\033[0;32mFinished: total %.3f seconds\033[0m\n' "$(( $(date +%s.%N) - zsh_start_time_total ))"
fi

[[ -f "$HOME/.local/bin/env" ]] && . "$HOME/.local/bin/env"
true
