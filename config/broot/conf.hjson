{
    // broot config. Only overrides; the shipped default covers the rest.
    // https://dystroy.org/broot/conf_file/

    // -g show git status, -h show hidden files, -i respect gitignore.
    // Applied to every launch so `br` in a checkout is immediately useful.
    default_flags: "-ghi"

    show_selection_mark: true

    // Open the selected file in the editor rather than broot's default
    // viewer.
    verbs: [
        {
            invocation: edit
            key: ctrl-e
            shortcut: e
            execution: "nvim {file}"
            leave_broot: false
        }
    ]
}
